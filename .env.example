# LLM API Keys
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Redis
REDIS_URL=redis://redis:6379/0

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://router:changeme@postgres:5432/llm_router
POSTGRES_DB=llm_router
POSTGRES_USER=router
POSTGRES_PASSWORD=changeme

# Routing thresholds (0.0–1.0)
COMPLEXITY_THRESHOLD_LOW=0.3
COMPLEXITY_THRESHOLD_HIGH=0.7

# Default provider order (comma-separated)
PROVIDER_PREFERENCE_ORDER=openai,anthropic,local

# Observability
LOG_LEVEL=INFO
ENVIRONMENT=development
GRAFANA_PASSWORD=admin
